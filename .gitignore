# Authored source/history only; downloaded binaries, game data and credentials
# remain local, including after the 0.4.2 workspace reorganization.
*
!/*.md
!/.gitignore
!/.gitattributes
!/src/
!/src/**/
!/src/**/*.lua
!/native/
!/native/**/*.c
!/native/**/*.h
!/native/**/*.S
!/tests/
!/tests/**/
!/tests/**/*.lua
!/tests/**/*.py
!/scripts/
!/scripts/*.py
!/scripts/*.cjs
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/*.txt
!/examples/
!/examples/*.example
!/research/
!/research/**/
!/research/**/*.lua
!/research/**/*.py
!/research/**/*.c
!/research/**/*.h
!/research/**/*.S
!/research/**/*.cjs
!/research/**/*.md
!/research/**/README*.txt
!/research/**/KEYS*.txt
!/research/**/*.example
# Generated or third-party/raw content even when it has a source extension.
/build/
/vendor/
/local_data/
/.local-github/
**/node_modules/
**/vendor/
**/arsenal_source/
**/manager-fixture-*/
