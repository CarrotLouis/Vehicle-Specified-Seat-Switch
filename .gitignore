# Publish authored work. Raw game assets, captures, logs, external checkouts,
# local credentials, dependencies and generated builds stay on this machine.
*
!/*.md
!/*.py
!/.gitignore
!/.gitattributes
!/seat_*/
!/seat_*/**/
!/seat_*/**/*.lua
!/seat_*/**/*.py
!/seat_*/**/*.c
!/seat_*/**/*.h
!/seat_*/**/*.S
!/seat_*/**/*.md
!/seat_*/*README*.txt
!/seat_*/*KEYS*.txt
!/seat_*/VehicleSeatSwitch.ini.example
!/baseline-*/
!/baseline-*/**/
!/baseline-*/**/*.lua
!/baseline-*/**/*.py
!/baseline-*/**/*.md
!/native_vehicle_research/
!/native_vehicle_research/**/*.py
!/native_vehicle_research/**/*.md
!/input_priority_research/
!/input_priority_research/*.py
!/input_priority_research/*.md
!/packaging_research/
!/packaging_research/*.py
!/packaging_research/*.cjs
!/packaging_research/*.md
!/menu_integration_research/
!/menu_integration_research/*.py
!/menu_integration_research/*.lua
!/menu_integration_research/*.md
# These are outputs even though their extension is Lua/Python.
/seat_*/bundled*.lua
/seat_*/check*.lua
/seat_*/helper.lua
/seat_*/runtime.lua
/seat_*/src/spin_fixture.lua
/seat_*/tests/*fixture*/
/seat_*/tests/transport-*/
/seat_*/tests/menu-*/
/seat_*/tests/check*.lua
/seat_*/tests/generated*/
# Explicitly protect every location that could hold credentials/artifacts.
/.local-github/
/tools/
/outputs/
/output/
**/outputs/
**/output/
**/node_modules/
**/__pycache__/
**/*.log
**/*.bin
**/*.zip
**/*.dll
**/*.exe
**/.git/

# Authored provenance needed to rebuild the current package.
!/seat_release_040/baseline.json
!/seat_release_041/baseline.json
